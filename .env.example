SUB2API_URL=http://sub2api:8080
SUB2API_KEY=change-me

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sub2api
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=change-me

TEST_MODEL=gpt-5.4-mini
MONITOR_INTERVAL_SECONDS=30
MONITOR_BATCH_SIZE=50
TEST_WORKERS=10
REFRESH_WORKERS=5
RETRY_ATTEMPTS=10
RETRY_DELAY_MS=500
OPENAI_GROUP_ID=2

DRY_RUN=0
ONCE=0
WEB_ENABLED=1
WEB_ADDR=:8788
WEB_PORT=8788
AUDIT_DIR=/app/data/sub2api_guardian
CONFIG_PATH=/app/data/sub2api_guardian/config.json
